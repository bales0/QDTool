<Window x:Class="QDTool.WaveformSaveOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tape export options"
        SizeToContent="WidthAndHeight"
        MinWidth="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="headingTextBlock" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Default tape machine:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="machineComboBox" Grid.Column="1" SelectedIndex="0" MinWidth="130">
                <ComboBoxItem Content="MZ-800"/>
                <ComboBoxItem Content="MZ-700"/>
            </ComboBox>
        </Grid>

        <TextBlock Grid.Row="2"
                   Foreground="DimGray"
                   TextWrapping="Wrap"
                   Margin="0,7,0,0"
                   Text="Loader and speed are taken from each table row. This machine is used only for records without an explicit profile."/>

        <StackPanel x:Name="layoutOptionsPanel" Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="Output layout:" Margin="0,0,0,4"/>
            <RadioButton x:Name="unionRadioButton"
                         Content="Union — all records in one file"
                         IsChecked="True"/>
            <RadioButton x:Name="separateRadioButton"
                         Content="Separate — one file per record"
                         Margin="0,5,0,0"/>
        </StackPanel>

        <TextBlock x:Name="separateHintTextBlock"
                   Grid.Row="4"
                   Foreground="DimGray"
                   TextWrapping="Wrap"
                   Margin="22,6,0,0"
                   Text="Separate files use the selected name as a base and add record number and name."/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Save" Width="80" IsDefault="True" Click="SaveButton_Click"/>
            <Button Content="Cancel" Width="80" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
