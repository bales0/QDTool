<Window x:Class="QDTool.TapeSaveOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tape save options"
        SizeToContent="WidthAndHeight"
        MinWidth="390"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="headingTextBlock" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <CheckBox x:Name="preserveTrailingCheckBox" Grid.Row="1" Margin="0,0,0,8"/>
        <StackPanel Grid.Row="2">
            <CheckBox x:Name="generateSidecarCheckBox"/>
            <TextBlock x:Name="existingSidecarTextBlock"
                       Foreground="DimGray"
                       TextWrapping="Wrap"
                       Margin="22,4,0,0"
                       Visibility="Collapsed"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Save" Width="80" IsDefault="True" Click="SaveButton_Click"/>
            <Button Content="Cancel" Width="80" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
