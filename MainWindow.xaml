<Window x:Class="QDTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QDTool"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Icon="/images/QDTool.ico"
        AllowDrop="True" DragEnter="Window_DragEnter" Drop="Window_Drop">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="739*"/>
            <ColumnDefinition Width="61*"/>
        </Grid.ColumnDefinitions>
        <DataGrid x:Name="MzfDataGrid" 
                  IsReadOnly="False"
                  AllowDrop="True"
                  PreviewMouseLeftButtonDown="MzfDataGrid_PreviewMouseLeftButtonDown"
                  PreviewMouseMove="MzfDataGrid_PreviewMouseMove"
                  DragOver="MzfDataGrid_DragOver"
                  DragLeave="MzfDataGrid_DragLeave"
                  Drop="MzfDataGrid_Drop"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  SelectionChanged="MzfDataGrid_SelectionChanged" 
                  CanUserAddRows="False" 
                  VerticalGridLinesBrush="LightGray" 
                  HeadersVisibility="Column" 
                  AutoGenerateColumns="False" 
                  CanUserSortColumns="False" 
                  Margin="10,10,91,80">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Type" Binding="{Binding MzfFtypeName}" Width="Auto" IsReadOnly="True"/>
                <DataGridTextColumn Header="File name" Binding="{Binding MzfFname}" Width="Auto" MinWidth="140" IsReadOnly="True"/>
                <DataGridTextColumn Header="Size" Binding="{Binding MzfSize}" Width="Auto" IsReadOnly="True"/>
                <DataGridTextColumn Header="Size(Hex)" Binding="{Binding MzfSizeHex}" Width="Auto" IsReadOnly="True"/>
                <DataGridTextColumn x:Name="trailingColumn" Header="Trailing" Binding="{Binding TrailingData}" Width="Auto" Visibility="Collapsed" IsReadOnly="True"/>
                <DataGridTextColumn Header="Start" Binding="{Binding MzfStartHex}" Width="Auto" IsReadOnly="True"/>
                <DataGridTextColumn Header="Exec" Binding="{Binding MzfExecHex}" Width="Auto" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Description" Width="*" MinWidth="180" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding MzfHeaderDescription}"
                                       Margin="4,2"
                                       ToolTip="{Binding MzfHeaderDescription}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn x:Name="loaderColumn" Header="Loader" Width="Auto" Visibility="Collapsed">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding LoaderTypes}"
                                      SelectedItem="{Binding LoaderType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectionChanged="LoaderComboBox_SelectionChanged"
                                      PreviewMouseLeftButtonDown="ProfileComboBox_PreviewMouseLeftButtonDown"
                                      MinWidth="88"
                                      Padding="2,0"
                                      ToolTip="Ctrl/Shift-select rows to change the profile for all selected records."/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn x:Name="speedColumn" Header="Speed" Width="Auto" Visibility="Collapsed">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding AvailableSpeeds}"
                                      SelectedItem="{Binding Speed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectionChanged="SpeedComboBox_SelectionChanged"
                                      PreviewMouseLeftButtonDown="ProfileComboBox_PreviewMouseLeftButtonDown"
                                      MinWidth="58"
                                      Padding="2,0"
                                      ToolTip="Ctrl/Shift-select rows to change the profile for all selected records."/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Button x:Name="openButton" Content="Open..." Margin="0,10,27,0" VerticalAlignment="Top" Click="button_Click_Open" HorizontalAlignment="Right" Width="66" Grid.ColumnSpan="2"/>
        <Button x:Name="saveButton" Content="Save As..." Margin="0,255,27,0" VerticalAlignment="Top" Click="button_Click_Save" HorizontalAlignment="Right" Width="66" Grid.ColumnSpan="2"/>
        <Button x:Name="newQuickDiskButton" Content="New..." Margin="0,290,27,0" VerticalAlignment="Top" Click="button_Click_NewQuickDisk" HorizontalAlignment="Right" Width="66" Grid.ColumnSpan="2" Visibility="Collapsed"/>
        <Button x:Name="formatQuickDiskButton" Content="Format..." Margin="0,325,27,0" VerticalAlignment="Top" Click="button_Click_FormatQuickDisk" HorizontalAlignment="Right" Width="66" Grid.ColumnSpan="2" Visibility="Collapsed"/>
        <CheckBox x:Name="advancedFeaturesCheckBox"
                  Content="Enable advanced features"
                  Margin="10,0,0,7"
                  VerticalAlignment="Bottom"
                  HorizontalAlignment="Left"
                  Grid.ColumnSpan="2"
                  Checked="AdvancedFeaturesCheckBox_Changed"
                  Unchecked="AdvancedFeaturesCheckBox_Changed"/>
        <Button x:Name="viewButton" Content="View" Margin="0,185,27,0" VerticalAlignment="Top" HorizontalAlignment="Right" Width="66" Click="button_Click_View" Grid.ColumnSpan="2"/>
        <Button x:Name="moveUpButton" FontFamily="Segoe UI" Content="&#x2191;" Margin="0,10,65,0" Click="button_Click_Up" Height="20" VerticalAlignment="Top" HorizontalAlignment="Right" Width="21"/>
        <Button x:Name="moveDownButton" FontFamily="Segoe UI" Content="&#x2193;" Margin="0,0,65,31" Click="button_Click_Down" Height="20" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="21"/>
        <Button x:Name="exportButton" Content="Export..." Margin="0,115,27,0" VerticalAlignment="Top" Click="button_Click_Export" HorizontalAlignment="Right" Width="66" Grid.ColumnSpan="2"/>
        <Button x:Name="addButton" Content="Add..." HorizontalAlignment="Right" Margin="0,45,27,0" VerticalAlignment="Top" Width="66" Click="button_Click_Add" Grid.ColumnSpan="2"/>
        <Label x:Name="infoText" Content="No data loaded" HorizontalAlignment="Left" Margin="205,0,0,4" Width="475" Height="26" VerticalAlignment="Bottom"/>
        <TextBlock x:Name="qdInfoText" Text="Quickdisk image type: —" HorizontalAlignment="Left" Margin="205,0,15,30" Height="42" VerticalAlignment="Bottom" Visibility="Collapsed" TextWrapping="Wrap" Grid.ColumnSpan="2"/>
        <Button x:Name="deleteButton" Content="Delete" Margin="0,220,27,0" VerticalAlignment="Top" Click="button_Click_Delete" HorizontalAlignment="Right" Width="66" Grid.ColumnSpan="2"/>
        <Button x:Name="exportAllButton" Content="Export All" Margin="0,150,27,0" VerticalAlignment="Top" Click="button_Click_ExportAll" HorizontalAlignment="Right" Width="66" Grid.ColumnSpan="2"/>
        <Button x:Name="clearAllButton" Content="Clear All" Margin="0,80,27,0" VerticalAlignment="Top" Click="button_Click_ClearAll" HorizontalAlignment="Right" Width="66" Grid.ColumnSpan="2"/>
        <Button x:Name="aboutButton" Content="About..." Margin="0,0,27,31" Grid.ColumnSpan="2" Height="20" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="66" Click="button_Click_About"/>
    </Grid>
</Window>
